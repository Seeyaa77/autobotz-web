# ============================================================
# FRONTEND ENVIRONMENT VARIABLES (.env)
# Copy to .env for Vite frontend
# ============================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: leave blank in dev to use Vite proxy '/api' -> http://localhost:5000
# In production, set to backend origin e.g. https://api.yourdomain.com
VITE_BACKEND_URL=

# ============================================================
# BACKEND ENVIRONMENT VARIABLES (.env.backend)
# Copy to .env.backend for Express backend (NEVER expose to browser)
# ============================================================
NODE_ENV=development
BACKEND_PORT=5000

# Supabase Admin (SUPABASE_URL falls back to VITE_SUPABASE_URL from .env if unset)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# CORS & Frontend Redirect URL
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed browser origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AES-256-GCM Encryption Keys (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BOT_TOKEN_ENC_KEY=replace-with-64-hex-char-aes-256-key
# Optional separate key for account inventory credentials (defaults to BOT_TOKEN_ENC_KEY)
ACCOUNT_CRED_ENC_KEY=

# Script License & Download Delivery (optional; download_url returns null if unset)
LICENSE_SECRET=replace-with-random-hmac-secret
SCRIPT_LATEST_VERSION=2.0.0
# Option A: Supabase private storage bucket + path (generates 10-min signed URL)
SCRIPT_DOWNLOAD_BUCKET=
SCRIPT_DOWNLOAD_PATH=
# Option B: Direct download URL fallback
SCRIPT_DOWNLOAD_URL=

# Midtrans Payment Gateway (leave MIDTRANS_SERVER_KEY blank to return 501 on midtrans & use QRIS/bank)
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Manual Payment Instructions (never hard-coded; empty if unset)
# Option A: JSON array of bank accounts: [{"bank":"BCA","number":"123456","holder":"PT Example"}]
MANUAL_BANK_ACCOUNTS_JSON=
# Option B: Individual bank env vars
MANUAL_BANK_BCA_ACCOUNT=
MANUAL_BANK_BCA_HOLDER=
MANUAL_BANK_MANDIRI_ACCOUNT=
MANUAL_BANK_MANDIRI_HOLDER=
MANUAL_BANK_BRI_ACCOUNT=
MANUAL_BANK_BRI_HOLDER=
MANUAL_BANK_BNI_ACCOUNT=
MANUAL_BANK_BNI_HOLDER=
# Optional QRIS image URL
MANUAL_QRIS_IMAGE_URL=
